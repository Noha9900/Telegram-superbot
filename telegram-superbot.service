[Unit]
Description=Telegram Community Super-Bot
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/telegram-superbot
EnvironmentFile=/opt/telegram-superbot/.env
ExecStart=/usr/bin/python3 bot.py
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/telegram-superbot/bot.log
StandardError=append:/var/log/telegram-superbot/bot.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
