# --- Telegram core (get from https://my.telegram.org) ---
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_from_botfather

# --- Access control ---
OWNER_ID=123456789
SUDO_USERS=111111111,222222222

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=superbot

# --- Private storage channel (bot must be admin there) ---
DB_CHANNEL_ID=-1001234567890

# --- Force Subscribe (comma separated channel ids, bot must be admin) ---
FSUB_CHANNELS=-1001112223334

# --- VIP / Billing ---
UPI_VPA=yourname@upi
UPI_QR_FILE_ID=
VIP_GROUP_ID=-1009998887776

# --- Welcome / assets ---
WELCOME_DELETE_SECONDS=10
DEFAULT_WELCOME_BANNER=assets/welcome_default.jpg
INVOICE_TEMPLATE_PATH=assets/invoice_template.png
FONT_REGULAR_PATH=assets/fonts/Regular.ttf
FONT_BOLD_PATH=assets/fonts/Bold.ttf

# --- Scheduler / tuning ---
SUBSCRIPTION_CHECK_INTERVAL_MIN=60
PHASH_DUPLICATE_THRESHOLD=6

# --- Runtime ---
WORKERS=8
LOG_LEVEL=INFO
TMP_DOWNLOAD_DIR=downloads
